{
  "name": "escrow-x",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"node backend/server.js\" \"vite --port=3000 --host=0.0.0.0\"",
    "server": "node backend/server.js",
    "client": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "python -m pytest -q",
    "wallet:new": "node scripts/new-wallet.mjs",
    "deploy:token": "node scripts/deploy-token.mjs",
    "build:contracts": "python scripts/build_contracts.py",
    "e2e:local": "node scripts/e2e-local.mjs",
    "compile:contracts": "vyper contracts/EscrowX.vy contracts/MockINR.vy",
    "token:lock-faucet": "node scripts/disable-faucet.mjs",
    "test:integration": "node tests/integration/part1.mjs && node tests/integration/part2.mjs && node tests/integration/part4.mjs && node tests/integration/part5.mjs",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "test:auth": "node tests/integration/auth-unit.mjs",
    "test:messages": "node tests/integration/messages-unit.mjs",
    "test:sandbox": "node tests/integration/sandbox-unit.mjs",
    "test:ipfs": "node tests/integration/ipfs-unit.mjs && node tests/integration/part3.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "axios": "^1.20.0",
    "concurrently": "^10.0.5",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "ethers": "^6.17.0",
    "express": "^4.21.2",
    "google-auth-library": "^11.3.4",
    "lucide-react": "^0.546.0",
    "mongoose": "^9.10.2",
    "motion": "^12.23.24",
    "nodemailer": "^10.6.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.4",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
