# Copy this to .env and fill in.

# Your already-deployed main contract — pre-filled with the one from
# PROJECT_STATUS.md. Change or leave blank to enter an address in the UI.
VITE_DEPLOYED_ESCROW_ADDRESS=0xB2012dc47b963a6e5edfaadcf707aca10edbfa58

# Only needed for the "Create Job" button (deploying a NEW EscrowJob
# instance from the UI). Get it with:
#   vyper -f bytecode contracts/EscrowJob.vy
# and paste the 0x... output below. Leave blank to disable Create Job
# (viewing/interacting with existing contracts still works fine).
VITE_ESCROW_BYTECODE=
