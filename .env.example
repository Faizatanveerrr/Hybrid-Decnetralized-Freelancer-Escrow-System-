# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# GEMINI_MODEL / GEMINI_FALLBACK_MODEL: arbitrator model, and the one tried if it keeps failing.
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_FALLBACK_MODEL="gemini-2.5-flash-lite"
# AI_FALLBACK: what happens if Gemini is unreachable or has no key.
#   low-confidence (default) - conservative ruling capped below 70%, so a secondary review is required
#   strict                   - refuse to rule and return an error
AI_FALLBACK="low-confidence"
# AI_RUN_PROJECT: when the arbitrator runs the freelancer's whole submitted project in a sandbox.
#   escalation (default) - only on secondary review (appeal, or low-confidence first ruling)
#   always               - also on the first ruling
#   off                  - never
AI_RUN_PROJECT="escalation"
# Sandbox (needs the `docker` CLI + daemon on the machine running the backend, e.g. `npm run dev`
# with Docker Desktop; it is NOT available inside the stock docker-compose `app` container).
# Run once to avoid a slow first ruling:  docker pull node:22-alpine && docker pull python:3.12-slim
# SANDBOX_MODE: docker (default) | off
SANDBOX_MODE="docker"
SANDBOX_NODE_IMAGE="node:22-alpine"
SANDBOX_PYTHON_IMAGE="python:3.12-slim"
SANDBOX_TIMEOUT_SEC=180
SANDBOX_MEMORY="768m"
SANDBOX_CPUS="1"
SANDBOX_MAX_UNPACKED_MB=100
# Dependency install is the only step with internet access. false = no network at all
# (projects that need npm/pip packages will then fail to install).
SANDBOX_INSTALL_NETWORK="true"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MONGODB_URI: Connection string for MongoDB instance.
MONGODB_URI="mongodb://localhost:27017/escrowx"
# Atlas "mongodb+srv://" failing with "querySrv ECONNREFUSED"? Your DNS blocks SRV lookups. The app retries with
# public DNS by itself; you can also force it here (or use Atlas's long mongodb:// connection string):
# DNS_SERVERS="8.8.8.8,1.1.1.1"

# PORT: Backend Express server port (defaults to 5000).
# Keep in sync with the proxy target in vite.config.ts.
PORT=5000

# --- On-chain settlement (INR token on Sepolia) ------------------------------
# RPC endpoint for Sepolia. Free options: https://ethereum-sepolia-rpc.publicnode.com
# or an Alchemy/Infura/Ankr project URL.
SEPOLIA_RPC_URL="https://ethereum-sepolia-rpc.publicnode.com"
CHAIN_ID=11155111
# Created by `npm run wallet:new` (the platform arbitrator that signs AI rulings).
# It needs a little Sepolia ETH for gas. NEVER commit this value.
ARBITRATOR_PRIVATE_KEY=""
# Written by `npm run deploy:token`.
TOKEN_ADDRESS=""
# Escrow timing in seconds. Short defaults are for demos; use e.g. 259200 / 172800 for real use.
REVIEW_PERIOD_SECONDS=900
APPEAL_WINDOW_SECONDS=300

# --- Fiat on-ramp: pay with UPI / Paytm / card (Razorpay) ---------------------
# Free test keys: https://dashboard.razorpay.com -> switch to Test Mode ->
# Account & Settings -> API Keys. Leave empty to disable the "Add money" button.
# PAYMENT_MODE (optional): razorpay | demo | off. If empty: razorpay when both keys below are
# set, otherwise "demo" - a built-in checkout that credits tokens WITHOUT any real payment
# (for demos when you have no Razorpay account). Demo mode is refused next to live payouts.
PAYMENT_MODE=""
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
MAX_TOPUP_INR=50000
# Wallet that owns the INR token and mints after a verified payment.
# Leave empty to use ARBITRATOR_PRIVATE_KEY (which owns it if you ran `npm run deploy:token`).
MINTER_PRIVATE_KEY=""
# Testnet only: ETH sent to a user's wallet after payment if it has no gas.
GAS_DRIP_ETH=0.03

# --- Login security + managed wallets (all created by `npm run wallet:new`) ---
# Signs login tokens. Without it, everyone is logged out on every server restart.
JWT_SECRET=""
# Encrypts the private keys of platform-managed user wallets (AES-256-GCM).
# Back it up: losing it makes every managed wallet unreadable. NEVER commit it.
WALLET_ENCRYPTION_KEY=""
# Debug only: accept the old unsigned x-user-id header instead of login tokens (insecure).
# ALLOW_INSECURE_HEADER_AUTH=true

# --- Withdrawals: INR tokens -> rupees to the user's UPI ID -------------------
# Leave RAZORPAYX_ACCOUNT_NUMBER empty to run in SIMULATED mode (no money moves).
# RazorpayX: https://x.razorpay.com -> My Account & Settings -> Banking -> Customer Identifier
# (the number differs between Test and Live mode). Uses RAZORPAY_KEY_ID / _SECRET above.
RAZORPAYX_ACCOUNT_NUMBER=""
MAX_PAYOUT_INR=10000

# --- Files on IPFS (deliverables, evidence, job specs, AI rulings) -----------
# Everything is ENCRYPTED before it is stored (IPFS content is public to anyone with
# its hash). Only the project's client and freelancer can decrypt it through the app.
# Pick ONE provider (auto-detected in this order if IPFS_PROVIDER is empty):
#   kubo   - your own IPFS node. docker compose runs one for you; for `npm run dev` start
#            `ipfs daemon` and set IPFS_API_URL.
#   pinata - hosted pinning service: set PINATA_JWT (free account at pinata.cloud).
#   local  - stored in MongoDB, NOT on the IPFS network. Demo only (the default if nothing is set).
#   none   - turn file storage off.
IPFS_PROVIDER=""
IPFS_API_URL=""
PINATA_JWT=""
IPFS_MAX_MB=10
# Optional separate encryption key for files (defaults to WALLET_ENCRYPTION_KEY). Back it up!
# IPFS_ENCRYPTION_KEY=""
